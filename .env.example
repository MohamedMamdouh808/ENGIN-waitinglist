# Copy to .env.local and fill in — never commit .env.local
# NEXT_PUBLIC_ vars are exposed to the browser, SUPABASE_SERVICE_ROLE_KEY is server-only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — from Supabase → Project Settings → API → service_role secret.
# Only read inside app/api/** via lib/supabase/server.ts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — secret gating GET /api/admin/signups-by-source.
# Generate with: openssl rand -hex 32. Pass as Authorization: Bearer <secret>.
ADMIN_SECRET=your-admin-secret
